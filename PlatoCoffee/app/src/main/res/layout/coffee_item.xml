<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/coffee_item_background">

        <!-- Coffee Image with rounded corners -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/image_frame_modern">

            <ImageView
                android:id="@+id/coffeeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cup" />

            <!-- Rating Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/rating_background"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp">

                <TextView
                    android:id="@+id/ratingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- Coffee Name -->
        <TextView
            android:id="@+id/coffeeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cappuccino Classic"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:layout_gravity="center_horizontal" />

        <!-- Coffee Price -->
        <TextView
            android:id="@+id/coffeePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R 45.13"
            android:textColor="#8B4513"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:layout_gravity="center_horizontal" />

        <!-- Add Button -->
        <Button
            android:id="@+id/addButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/add_button_background"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>